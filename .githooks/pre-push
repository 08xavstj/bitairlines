#!/usr/bin/env bash
# Checks the game core before a push, so a broken build is caught here instead of in a red CI run (and an email).
# Turn it on once per clone:  git config core.hooksPath .githooks
# It runs the purity check always, and the Core tests when Swift (or Docker) is installed. Skip once with: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bash tools/check-core-purity.sh
if command -v swift >/dev/null 2>&1; then
  swift test --package-path AirlineCore
elif command -v docker >/dev/null 2>&1; then
  docker run --rm -v "$PWD:/w" -w /w swift:6.1 swift test --package-path AirlineCore
else
  echo "pre-push: no Swift or Docker here, so only the purity check ran"
fi
